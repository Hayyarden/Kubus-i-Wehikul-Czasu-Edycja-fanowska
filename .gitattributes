# Auto detect text files and perform LF normalization
* text=auto
*.cmd text eol=crlf
*.bat text eol=crlf
*.exe binary
*.dcr binary
*.dll binary
*.sh text eol=lf
# pliki techniczne repozytorium pomijane w archiwach "Source code" na GitHubie
.gitignore export-ignore
.gitattributes export-ignore
.github export-ignore
